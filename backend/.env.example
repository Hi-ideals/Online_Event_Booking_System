# ---------- Server ----------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=event_booking
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ---------- JWT ----------
# Use long random strings in production
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# ---------- Booking ----------
# Minutes seats/tickets stay reserved while the attendee pays
BOOKING_HOLD_MINUTES=10
# Convenience fee charged to the attendee, as a percent of the ticket subtotal
CONVENIENCE_FEE_PERCENT=0

# ---------- Payments ----------
# "mock" simulates the gateway locally; "razorpay" uses the real Razorpay API
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=change_me_mock_secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Tickets ----------
# Signs the QR code on every ticket. Changing it invalidates existing QR codes.
TICKET_QR_SECRET=change_me_qr_secret

# ---------- Check-in ----------
# Gates open this many hours before the event starts and close this many hours after it ends
CHECKIN_OPENS_HOURS_BEFORE=24
CHECKIN_CLOSES_HOURS_AFTER=6

# ---------- Invoice details ----------
PLATFORM_NAME=EventBooking
PLATFORM_ADDRESS=Bengaluru, Karnataka, India
PLATFORM_GSTIN=
PLATFORM_SUPPORT_EMAIL=support@eventbooking.com

# ---------- Email ----------
# Leave SMTP_HOST empty in development: emails are saved as .eml files in storage/emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EventBooking <no-reply@eventbooking.com>

# ---------- Seed: first admin account ----------
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@eventbooking.com
ADMIN_PASSWORD=Admin@12345
